# Production site origin used for trusted payment return links.
PUBLIC_SITE_URL="https://oldi-sotdi.uz"

# GEMINI_API_KEY: Required for Gemini AI product-image generation.
# Keep the real key in Vercel Environment Variables only; never commit it here.
GEMINI_API_KEY=""

# Firebase API key used server-side only to verify Firebase ID tokens through
# Google Identity Toolkit. Firebase web API keys are identifiers, not admin secrets.
# Prefer setting this in Vercel so the server does not depend on a source fallback.
FIREBASE_API_KEY=""

# TELEGRAM INTEGRATION
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID="@OSot_uz"
TELEGRAM_BOT_USERNAME="OSotBot"

# CLICK CHECKOUT
# Both values come from your Click merchant account.
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""

# PAYME CHECKOUT
# Merchant ID from your Payme Business account.
PAYME_MERCHANT_ID=""
