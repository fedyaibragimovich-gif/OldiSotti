{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/telegram/test-connection",
      "dest": "/api/telegram/test-connection.ts"
    },
    {
      "src": "/api/telegram/post-listing",
      "dest": "/api/telegram/post-listing.ts"
    },
    {
      "src": "/api/telegram/send-notification",
      "dest": "/api/telegram/send-notification.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
