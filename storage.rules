rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    match /users/{userId}/listings/{listingId}/{fileName} {
      allow get: if true;
      allow list: if owner(userId);
      allow create, update: if owner(userId)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if owner(userId) || (request.auth != null && request.auth.uid == 'Q81AQDKw7GXYeNgdrnp2qvYgyS02');
    }
  }
}
