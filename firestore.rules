rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Public marketplace feed. Only the authenticated owner (or admin) can mutate an ad.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && (
          isAdmin()
          || (
            resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
          )
        );
      allow delete: if signedIn()
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    // Conversations are private to their Firebase Auth participants.
    match /conversations/{conversationId} {
      allow read, create: if signedIn()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.hasAny([request.auth.uid]);
      allow update, delete: if signedIn()
        && resource.data.participantIds is list
        && resource.data.participantIds.hasAny([request.auth.uid]);

      match /messages/{messageId} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds.hasAny([request.auth.uid]);
      }
    }

    // Never expose platform secrets such as a Telegram bot token to clients.
    // Public client reads are disabled; only an admin may manage this document.
    match /platform_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Reports may be submitted by signed-in users; only admins can review/change them.
    match /moderation_reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    // User profiles are private to the owner, with admin access for moderation.
    match /users/{userId} {
      allow read, write: if signedIn()
        && (request.auth.uid == userId || isAdmin());
    }
  }
}
