rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && (
          isAdmin()
          || (
            resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
          )
        );
      allow delete: if signedIn()
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && resource.data.participantIds is list
        && resource.data.participantIds.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.hasAny([request.auth.uid]);
      allow update, delete: if signedIn()
        && resource.data.participantIds is list
        && resource.data.participantIds.hasAny([request.auth.uid]);

      match /messages/{messageId} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds.hasAny([request.auth.uid]);
      }
    }

    match /platform_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /moderation_reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if signedIn()
        && (request.auth.uid == userId || isAdmin());
    }
  }
}
