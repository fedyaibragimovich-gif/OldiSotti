rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'Q81AQDKw7GXYeNgdrnp2qvYgyS02' ||
        (request.auth.token.email != null && request.auth.token.email_verified == true && request.auth.token.email.lower() == 'fedya.ibragimovich@gmail.com')
      );
    }

    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }

    function initialListingStatus() {
      return exists(/databases/$(database)/documents/platform_settings/global_config)
        && get(/databases/$(database)/documents/platform_settings/global_config).data.get('autoApproveListings', false) == true
        ? 'active' : 'pending';
    }


    function validListingShape() {
      let data = request.resource.data;
      return data.currency in ['UZS', 'USD']
        && data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 100
        && data.location is map && data.location.region is string
        && data.location.region.size() > 0 && data.location.region.size() <= 100
        && data.location.get('district', '') is string
        && data.location.get('address', '') is string
        && data.condition in ['new', 'used']
        && data.isNegotiable is bool && data.isDeliveryAvailable is bool
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 50
        && data.seller is map && data.seller.name is string && data.seller.name.size() <= 100
        && data.seller.phone is string && data.seller.phone.size() <= 30;
    }

    function validMessage(message) {
      return message.keys().hasOnly(['id', 'sender', 'text', 'timestamp'])
        && message.id is string && message.id.size() > 0 && message.id.size() <= 150
        && message.timestamp is string && message.timestamp.size() <= 50
        && message.text is string && message.text.size() > 0 && message.text.size() <= 2000;
    }

    function safeUnreadUpdate() {
      let before = resource.data.get('unreadCountByUser', {});
      let after = request.resource.data.get('unreadCountByUser', {});
      let recipient = resource.data.buyerId == request.auth.uid ? resource.data.sellerUserId : resource.data.buyerId;
      return after is map && (
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['messages'])
          && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
          && after.get(request.auth.uid, 0) == 0)
        || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['messages'])
          && after.diff(before).affectedKeys().hasOnly([recipient])
          && after.get(recipient, 0) == before.get(recipient, 0) + 1)
      );
    }

    function validListingContent() {
      return validListingShape() && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.description is string && request.resource.data.description.size() <= 5000
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.images is list
        && request.resource.data.images.size() > 0 && request.resource.data.images.size() <= 4;
    }

    function listingExists(listingId) {
      return exists(/databases/$(database)/documents/listings/$(listingId));
    }

    function listingOwnerUid(listingId) {
      return get(/databases/$(database)/documents/listings/$(listingId)).data.userId;
    }

    function isSafeNewListing() {
      return signedIn() && validListingShape()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 5000
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.images is list
        && request.resource.data.images.size() > 0
        && request.resource.data.images.size() <= 4
        && request.resource.data.viewsCount is number
        && request.resource.data.viewsCount >= 0
        && request.resource.data.viewsCount <= 1
        && request.resource.data.isVip == false
        && request.resource.data.isTop == false
        && request.resource.data.isPostedToTelegram == false
        && request.resource.data.status == initialListingStatus()
        && request.resource.data.seller is map
        && request.resource.data.seller.isVerified == false
        && request.resource.data.seller.id == request.auth.uid;
    }

    function isOwnerListingUpdate() {
      return signedIn() && resource.data.userId == request.auth.uid
        && validListingContent()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'price', 'currency', 'images', 'categoryId', 'subcategoryId',
          'location', 'condition', 'isNegotiable', 'isDeliveryAvailable', 'status'
        ])
        && (request.resource.data.status == 'pending'
          || (resource.data.status in ['active', 'reserved', 'sold']
            && request.resource.data.status in ['active', 'reserved', 'sold']))
        && (initialListingStatus() == 'active'
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'title', 'description', 'images', 'categoryId', 'subcategoryId'
          ]) || request.resource.data.status == 'pending');
    }

    function isViewIncrementOnly() {
      return signedIn() && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount'])
        && request.resource.data.viewsCount is number
        && resource.data.viewsCount is number
        && request.resource.data.viewsCount == resource.data.viewsCount + 1;
    }

    function isConversationParticipant() {
      return signedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerUserId == request.auth.uid
      );
    }

    function isConversationParticipantById(conversationId) {
      return signedIn() && (
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.buyerId == request.auth.uid ||
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.sellerUserId == request.auth.uid
      );
    }

    function safeInitialUnread() {
      let counters = request.resource.data.get('unreadCountByUser', {});
      return counters is map
        && counters.keys().hasOnly([request.auth.uid, request.resource.data.sellerUserId])
        && counters.get(request.auth.uid, 0) == 0
        && counters.get(request.resource.data.sellerUserId, 0) == request.resource.data.messages.size();
    }

    function isSafeNewConversation() {
      return signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerUserId is string
        && request.resource.data.sellerUserId != request.auth.uid
        && request.resource.data.listingId is string
        && listingExists(request.resource.data.listingId)
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status == 'active'
        && listingOwnerUid(request.resource.data.listingId) == request.resource.data.sellerUserId
        && request.resource.data.messages is list
        && request.resource.data.messages.size() <= 1
        && safeInitialUnread()
        && (request.resource.data.messages.size() == 0 || (
          validMessage(request.resource.data.messages[0])
          && request.resource.data.messages[0].sender == 'buyer'
          && request.resource.data.messages[0].text is string
          && request.resource.data.messages[0].text.size() > 0
          && request.resource.data.messages[0].text.size() <= 2000
        ));
    }

    function isSafePaymentOrder() {
      return signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.listingId is string
        && listingExists(request.resource.data.listingId)
        && listingOwnerUid(request.resource.data.listingId) == request.auth.uid
        && request.resource.data.provider in ['click', 'payme']
        && request.resource.data.planDays in [1, 3, 7]
        && request.resource.data.amountUzs == request.resource.data.planDays * 25000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    match /listings/{listingId} {
      allow get: if !exists(/databases/$(database)/documents/listings/$(listingId));
      allow read: if resource.data.status == 'active' || isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || isSafeNewListing();
      allow update: if isAdmin() || isOwnerListingUpdate() || isViewIncrementOnly();
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || isConversationParticipant();
      allow create: if isAdmin() || isSafeNewConversation();
      allow update: if isAdmin() || (
        isConversationParticipant()
        && safeUnreadUpdate()
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.sellerUserId == resource.data.sellerUserId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages', 'lastUpdated', 'unreadCountByUser'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'listingId','listingTitle','listingPrice','listingCurrency','listingImage',
          'sellerId','sellerName','sellerAvatar','sellerPhone'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['messages']) || (
          validMessage(request.resource.data.messages[resource.data.messages.size()])
          && request.resource.data.messages.size() == resource.data.messages.size() + 1
          && request.resource.data.messages == resource.data.messages.concat([request.resource.data.messages[resource.data.messages.size()]])
          && request.resource.data.messages[resource.data.messages.size()].sender == (resource.data.buyerId == request.auth.uid ? 'buyer' : 'seller')
          && request.resource.data.messages[resource.data.messages.size()].text is string
          && request.resource.data.messages[resource.data.messages.size()].text.size() > 0
          && request.resource.data.messages[resource.data.messages.size()].text.size() <= 2000
        ))
      );
      allow delete: if isAdmin() || isConversationParticipant();

      match /messages/{messageId} {
        allow read: if isAdmin() || isConversationParticipantById(conversationId);
        allow create: if isAdmin() || (
          isConversationParticipantById(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
        );
        allow update, delete: if isAdmin();
      }
    }

    match /platform_settings/{settingId} {
      allow read: if isAdmin() || !resource.data.keys().hasAny(['telegramBotToken']);
      allow write: if isAdmin() && !request.resource.data.keys().hasAny(['telegramBotToken']);
    }

    match /users/{userId} {
      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    match /moderation_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.reason in ['spam', 'price', 'prohibited', 'fraud', 'other']
        && request.resource.data.get('comment', '') is string
        && request.resource.data.get('comment', '').size() <= 2000
        && request.resource.data.listingTitle is string && request.resource.data.listingTitle.size() <= 80
        && request.resource.data.createdAt is string
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.listingId is string
        && listingExists(request.resource.data.listingId);
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.recipientId == request.auth.uid);
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.type == 'message'
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.chatId is string
        && request.resource.data.listingId is string
        && get(/databases/$(database)/documents/conversations/$(request.resource.data.chatId)).data.listingId == request.resource.data.listingId
        && (
          (
            get(/databases/$(database)/documents/conversations/$(request.resource.data.chatId)).data.buyerId == request.auth.uid
            && get(/databases/$(database)/documents/conversations/$(request.resource.data.chatId)).data.sellerUserId == request.resource.data.recipientId
          ) || (
            get(/databases/$(database)/documents/conversations/$(request.resource.data.chatId)).data.sellerUserId == request.auth.uid
            && get(/databases/$(database)/documents/conversations/$(request.resource.data.chatId)).data.buyerId == request.resource.data.recipientId
          )
        )
      );
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.recipientId == request.auth.uid);
    }

    match /payment_orders/{orderId} {
      allow create: if isSafePaymentOrder();
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /blocked_sellers/{blockId} {
      allow get: if signedIn() && !exists(/databases/$(database)/documents/blocked_sellers/$(blockId));
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.sellerUserId is string
        && request.resource.data.sellerUserId != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.sellerUserId;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
