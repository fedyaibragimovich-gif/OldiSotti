rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'Q81AQDKw7GXYeNgdrnp2qvYgyS02';
    }

    function signedIn() {
      return request.auth != null;
    }

    function isConversationParticipant() {
      return signedIn()
        && (resource.data.buyerId == request.auth.uid
          || resource.data.sellerUserId == request.auth.uid);
    }

    function isNewConversationParticipant() {
      return signedIn()
        && (request.resource.data.buyerId == request.auth.uid
          || request.resource.data.sellerUserId == request.auth.uid);
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || isConversationParticipant();
      allow create: if isAdmin() || isNewConversationParticipant();
      allow update: if isAdmin() || (isConversationParticipant()
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.sellerUserId == resource.data.sellerUserId);
      allow delete: if isAdmin() || isConversationParticipant();

      match /messages/{messageId} {
        allow read, write: if isAdmin() || isConversationParticipant();
      }
    }

    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    match /moderation_reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }
  }
}
